# ==========================================
# Personal Finance Management - Environment Variables Template
# Copy this file to .env and replace placeholder values with your production secrets
# ==========================================

# Port mapping on host (Default: 80)
APP_PORT=80

# Database Configuration (MySQL)
DB_ROOT_PASSWORD=replace_with_strong_mysql_root_password_123!
DB_NAME=personal_finance
DB_USERNAME=finance_user
DB_PASSWORD=replace_with_strong_mysql_user_password_456!

# Redis Cache & Token Blacklist
REDIS_PASSWORD=replace_with_strong_redis_password_789!

# Security & JWT (Must be at least 32-64 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_should_be_at_least_64_characters_long_for_security

# Mail Service (Gmail SMTP App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cloudinary (Media / Receipts upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OAuth2 Authentication
# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional: Custom Redirect URI if behind custom domain (e.g. https://yourdomain.com/oauth2/redirect)
APP_OAUTH2_REDIRECT_URI=

# Plaid API (Banking integration)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENVIRONMENT=sandbox

# Gemini AI (Smart categorization & financial assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# Docker Image Tags (Used when deploying prebuilt images from GHCR)
SERVER_IMAGE=ghcr.io/your-github-username/personal-finance-server:latest
CLIENT_IMAGE=ghcr.io/your-github-username/personal-finance-client:latest
